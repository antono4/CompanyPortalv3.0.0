RewriteEngine On

# Deny direct access to sensitive directories (must run before the file check)
RewriteRule ^(app|config|storage|database)(/|$) - [F,L]

# Map /assets/* to the public assets folder
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Serve the site icon requested by browsers at the web root
RewriteRule ^favicon\.ico$ public/assets/img/favicon.ico [L]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to the front controller
RewriteRule ^ public/index.php [QSA,L]
